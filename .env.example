NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Used by `npm run db:seed` to create the first superadmin account
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Public base URL of this backend, used to build image links for the frontend
APP_URL=http://localhost:4000

# Outgoing email (nodemailer). Leave SMTP_HOST empty in development: emails are then printed in the server log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Prafi <no-reply@prafi.local>
