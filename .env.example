NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# API request/error logs (GET /api/logs) are kept this many days
LOG_RETENTION_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Used by `npm run db:seed` to create the first superadmin account
SEED_ADMIN_EMAIL=transmigrasiprafitep@gmail.com
SEED_ADMIN_PASSWORD=Admin123!

# Public base URL of this backend, used to build image links for the frontend
APP_URL=http://localhost:4000

# Public URL of the frontend: the forgot-password email links to <FRONTEND_URL>/reset-password?userId=...&token=...,
# and every email shows the logo from <FRONTEND_URL>/logo.png
FRONTEND_URL=http://localhost:5173

# Landing pages refresh at once after a public change (product, review, category, UMKM profile, approval):
# the backend calls the frontend's /internal/revalidate with this secret. Use the same value as REVALIDATE_SECRET in
# the frontend .env (generate one: openssl rand -hex 32). Empty = off (pages refresh within 60 s).
REVALIDATE_SECRET=
# Optional: where to call it (default <FRONTEND_URL>/internal/revalidate). On the same server the frontend can be
# reached directly, e.g. http://127.0.0.1/internal/revalidate
FRONTEND_REVALIDATE_URL=

# Outgoing email (nodemailer). Leave SMTP_HOST empty in development: emails are then printed in the server log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trans Niaga <no-reply@transniaga.local>
